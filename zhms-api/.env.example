# ---------------------------------------------------------------- required
DATABASE_URL=postgres://zhms:change-me@localhost:5432/zhms
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5000
# Explicit browser origins; required (and "*" refused) when NODE_ENV=production.
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost

# ---------------------------------------------------------------- environment & hardening
# production (default when unset) | development | test. Production refuses unsafe settings at start-up.
NODE_ENV=production
# Least privilege: connect as a dedicated owner role, never the "postgres" superuser, and require TLS
# off-host, e.g. postgres://zhms_app:<secret>@db.internal:5432/zhms?sslmode=require
# Set to true only when the API sits behind a TLS-terminating reverse proxy (one hop).
TRUST_PROXY=false
# Development only (refused in production): enables POST /payments/ecocash-push, which credits a payment
# WITHOUT a gateway signature.
ENABLE_PAYMENT_SIMULATOR=false
# Development only: print SMS/WhatsApp bodies (buyer PII) when the console provider is used.
LOG_MESSAGE_BODIES=false

# ---------------------------------------------------------------- payment webhooks
# One shared secret (32+ chars) per channel, agreed with the gateway / bank integrator.
# A channel with no secret rejects all webhooks (HTTP 404).
#
#   POST /api/v1/webhooks/payments/{ECOCASH|BANK_TRANSFER|OMARI|DEBIT_ORDER}
#   X-ZHMS-Timestamp: <unix seconds>                      (must be within 5 minutes of server time)
#   X-ZHMS-Signature: sha256=<hex HMAC-SHA256 of "<timestamp>.<raw body>" with the channel secret>
#   {
#     "reference":  "EC-992014812",      provider transaction id (unique per channel; retries are ignored)
#     "accountRef": "ZB-1A2B3C4D",       the buyer's payment reference from their SMS / statement
#     "amount":     "50.00",
#     "currency":   "USD" | "ZWG",       ZWG is converted at the latest rate recorded by finance
#     "status":     "SUCCESS",           anything else is acknowledged and ignored
#     "paidAt":     "2026-10-08T09:42:15Z",   optional
#     "payerPhone": "+263774128901"            optional
#   }
#
# Response is always 200 once the signature is valid: {"outcome": "APPLIED" | "DUPLICATE" | "PENDING_REVIEW" | "IGNORED"}.
# PENDING_REVIEW items (unknown reference, inactive stand, missing/stale ZiG rate) wait in the finance payment inbox.
# EcoCash, banks and O'mari each have their own callback formats: a small adapter that maps their callback
# into the body above and signs it is still needed per provider once merchant agreements are in place.
WEBHOOK_SECRET_ECOCASH=
WEBHOOK_SECRET_BANK_TRANSFER=
WEBHOOK_SECRET_OMARI=
WEBHOOK_SECRET_DEBIT_ORDER=

# ---------------------------------------------------------------- buyer messaging
# "console" writes messages to the server log instead of sending them (a warning is printed at start-up).
WHATSAPP_PROVIDER=console        # console | cloud   (Meta WhatsApp Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
# Templates zhms_payment_receipt, zhms_payment_reminder, ... must be approved in WhatsApp Manager first;
# their {{1}}..{{n}} variables follow the `vars` order in src/messaging.js.

SMS_PROVIDER=console             # console | http   (any gateway accepting POST {to, from, message})
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=ZIMBUILD

# ---------------------------------------------------------------- scheduled jobs
# Overdue marking, reminders, monthly statements, reservation expiry. 0 disables (use an external scheduler
# calling POST /api/v1/admin/jobs/run instead). Queued messages are dispatched every 30 seconds.
JOB_INTERVAL_MINUTES=15

# Business rules (deposit %, instalment term, monthly rate, grace days, reminder lead time, youth age limit,
# maximum ZiG rate age) live in the app_config table so the business can change them without a deploy.
