{
  "name": "zhms-api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "ZimBuild Housing Management System - API (PostgreSQL/PostGIS)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/migrate.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:construction": "node --env-file=.env scripts/seed-construction.js",
    "issue-token": "node --env-file=.env scripts/issue-token.js",
    "test": "node scripts/test.js",
    "test:unit": "node --test \"tests/unit/**/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "^18.0.0-beta.1"
  }
}
