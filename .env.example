# Production settings for docker-compose.yml. Copy to .env (never commit .env) and fill in every value.
# docker compose refuses to start while a required value is missing.
#
# Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=                 # >= 32 characters; must match the identity provider that issues ZHMS tokens
ZIMBUILD_HMAC_SECRET=       # >= 32 characters; signs prototype ERP transactions

# --- Optional ---------------------------------------------------------------
POSTGRES_USER=zhms
POSTGRES_DB=zhms
CORS_ORIGINS=https://zhms.zimbuild.co.zw,https://portal.zimbuild.co.zw

# Payment gateway webhook secrets (>= 32 characters each). A channel left empty rejects all webhooks.
WEBHOOK_SECRET_ECOCASH=
WEBHOOK_SECRET_BANK_TRANSFER=
WEBHOOK_SECRET_OMARI=
WEBHOOK_SECRET_DEBIT_ORDER=
